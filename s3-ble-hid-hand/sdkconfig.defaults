# ===== 目标板：ESP32-S3-DEV-KIT-N16R8-U（模组 ESP32-S3-WROOM-1U-N16R8：16MB Quad Flash + 8MB Octal PSRAM，U = 外接天线 IPEX）=====
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8MB Octal PSRAM（N16R8 为 OPI PSRAM，占用 GPIO35/36/37，固件不使用这三个脚）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# 日志走 UART0 → 板上 CH343 USB-UART 口（1a86:55d3）
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# 1 ms tick，保证点击按住/长按/逐键间隔的毫秒精度
CONFIG_FREERTOS_HZ=1000

# ===== BLE：NimBLE，仅外设角色，单连接，单个绑定 =====
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="S3 Phone Hand"
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=31
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ===== Wi-Fi（v1.1.0 局域网 TCP 透传）：STA only，与 BLE 软件共存；凭据只在运行时写 NVS，不在这里 =====
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_LOCAL_HOSTNAME="s3-phone-hand"
